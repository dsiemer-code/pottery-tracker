rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Who can do what. These are written around ownership, not around each feature, so new parts of the app
    // where people add their own things work without publishing new rules:
    //   Full access - listed under studio/shared/members with role "full": see and change everything, manage people.
    //   Student     - listed with role "student": see everything; add their own things (marked with their uid in "by")
    //                 and change or delete only those.
    //   Anyone else who signs in can only ask to be let in (studio/shared/requests) and see their own request.
    // The first person to open the app after these rules are published becomes the first "full" member
    // (that's what settings/setup records). Publish these before turning sign-up back on.
    function signedIn() { return request.auth != null; }
    function memberPath() { return /databases/$(database)/documents/studio/shared/members/$(request.auth.uid); }
    function setupPath() { return /databases/$(database)/documents/studio/shared/settings/setup; }
    function member() { return signedIn() && exists(memberPath()); }
    function full() { return member() && get(memberPath()).data.role == "full"; }
    // People, requests and settings have their own rules below; everything else is the studio's records
    function records(col) { return !(col in ["members", "requests", "settings"]); }
    function mineBefore() { return resource.data.by == request.auth.uid; }
    function mineAfter() { return request.resource.data.by == request.auth.uid; }
    // A student's piece must be marked as one, so it shows under Student pieces, not with the studio's own
    function markedOk(col) { return col != "pieces" || request.resource.data.student == true; }

    // The studio's records: pieces, glazes, photos, inspiration, and anything added later
    match /studio/shared/{col}/{id} {
      allow read: if member() && col != "requests";
      allow write: if full() && records(col);
      allow create: if member() && records(col) && mineAfter() && markedOk(col);
      allow update: if member() && records(col) && mineBefore() && mineAfter() && markedOk(col);
      allow delete: if member() && records(col) && mineBefore();
    }
    match /studio/shared/settings/studio {
      allow write: if full();
    }

    // First-time setup marker: anyone signed in can check it; it can only be made once, with its first member
    match /studio/shared/settings/setup {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(setupPath()) && existsAfter(memberPath());
    }

    // People
    match /studio/shared/members/{uid} {
      allow read: if member() || (signedIn() && request.auth.uid == uid);
      allow create: if full()
        || (signedIn() && request.auth.uid == uid && !exists(setupPath()) && existsAfter(setupPath()) && request.resource.data.role == "full");
      allow update: if full() && (request.auth.uid != uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "short"]));
      allow delete: if full() && request.auth.uid != uid;
    }

    // Asking to be let in
    match /studio/shared/requests/{uid} {
      allow read: if full() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid;
      allow delete: if full();
    }
  }
}
