rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everyone who can sign in shares the same pottery records.
    // Only accounts added under Authentication -> Users can sign in
    // (sign-up is turned off in Authentication -> Settings -> User actions).
    match /studio/shared/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
